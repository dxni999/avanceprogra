        <mxCell id="titulo" value="Dizeo - UML preliminar de la solución propuesta&lt;br&gt;Diseño para Progreso 1. Revisión del equipo pendiente." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1080" height="70" as="geometry" />
        </mxCell>
        <mxCell id="Obra" value="&lt;b&gt;Obra&lt;/b&gt;&lt;hr&gt;- codigo: String&lt;br&gt;- finComprometido: LocalDate&lt;br&gt;- estado: EstadoObra&lt;hr&gt;+ reprogramar(fecha, motivo)&lt;br&gt;+ calcularAvance(): double" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#F0F6F7;strokeColor=#426B82;fontSize=17;" vertex="1" parent="1">
