        <mxCell id="Actividad" value="&lt;b&gt;Actividad&lt;/b&gt;&lt;hr&gt;- codigo: String&lt;br&gt;- duracion: Duration&lt;br&gt;- prioridad: Prioridad&lt;br&gt;- personalRequerido: int&lt;hr&gt;+ cambiarPrioridad(p)&lt;br&gt;+ puedeIniciar(): boolean" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#F0F6F7;strokeColor=#426B82;fontSize=17;" vertex="1" parent="1">
