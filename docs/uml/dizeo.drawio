        <mxCell id="Usuario" value="&lt;b&gt;Usuario&lt;/b&gt;&lt;hr&gt;- id: UUID&lt;br&gt;- rol: Rol&lt;br&gt;- credencialHash: String&lt;hr&gt;+ tienePermiso(accion)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#F0F6F7;strokeColor=#426B82;fontSize=17;" vertex="1" parent="1">
