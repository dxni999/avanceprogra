  <diagram id="1_Dominio_y_asignacion" name="1 Dominio y asignacion">
    <mxGraphModel dx="1200" dy="1400" grid="1" gridSize="10" page="1" pageWidth="1169" pageHeight="1400">
      <root>
        <mxCell id="0" />
