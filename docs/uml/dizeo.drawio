        <mxCell id="titulo2" value="Dizeo - UML de seguimiento y versiones&lt;br&gt;Actividad y Usuario son las mismas clases de la primera vista." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1080" height="70" as="geometry" />
        </mxCell>
        <mxCell id="Actividad" value="&lt;b&gt;Actividad&lt;/b&gt;&lt;hr&gt;- codigo: String&lt;br&gt;- estado: EstadoActividad&lt;hr&gt;+ cerrar(avanceValidado)&lt;br&gt;+ tieneIncidenciasAbiertas()" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#F0F6F7;strokeColor=#426B82;fontSize=17;" vertex="1" parent="1">
