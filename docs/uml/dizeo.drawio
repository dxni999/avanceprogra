        </mxCell>
        <mxCell id="e6" value="0..* predecesoras / 0..* sucesoras" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;fontSize=15;labelBackgroundColor=#FFFFFF;strokeColor=#426B82;loopDirection=north;exitX=0.7;exitY=0;entryX=0.3;entryY=0;" edge="1" parent="1" source="Actividad" target="Actividad">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nota" value="Cada actividad pertenece a una obra. Las dependencias son de la misma obra, sin ciclos.&lt;br&gt;La asignación confirma exactamente el personal requerido y respeta horario, especialidad y traslados.&lt;br&gt;Composición indica pertenencia exclusiva y conserva la baja lógica." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="1220" width="1080" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
